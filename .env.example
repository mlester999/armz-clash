# =============================================================================
# Armz Clash — environment template
# Copy to .env. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL
# -----------------------------------------------------------------------------
NODE_ENV=development
ARMZ_ENVIRONMENT=development
ARMZ_APP_VERSION=0.1.0
ARMZ_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PUBLIC PRODUCT
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ARMZ_PRODUCT_NAME=Armz Clash
NEXT_PUBLIC_ARMZ_TOKEN_NAME=Armz
NEXT_PUBLIC_ARMZ_TOKEN_SYMBOL=ARMZ
NEXT_PUBLIC_ARMZ_NETWORK=devnet
NEXT_PUBLIC_ARMZ_DOCS_VERSION=0.2.0-phase2
NEXT_PUBLIC_ARMZ_ENVIRONMENT=development
NEXT_PUBLIC_ARMZ_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ARMZ_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ARMZ_GAME_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# FEATURE FLAGS (safe defaults — real-value systems OFF)
# -----------------------------------------------------------------------------
ARMZ_DEMO_MODE_ENABLED=true
ARMZ_REAL_MINT_ENABLED=false
ARMZ_REAL_REWARDS_ENABLED=false
ARMZ_CLAIMS_ENABLED=false
ARMZ_MARKETPLACE_ENABLED=false
ARMZ_MARKETPLACE_SETTLEMENT_ENABLED=false
ARMZ_ORACLE_ENABLED=false
ARMZ_MAINNET_ENABLED=false
ARMZ_ADMIN_ECONOMY_WRITES_ENABLED=false

NEXT_PUBLIC_ARMZ_DEMO_MODE_ENABLED=true
NEXT_PUBLIC_ARMZ_REAL_MINT_ENABLED=false
NEXT_PUBLIC_ARMZ_REAL_REWARDS_ENABLED=false
NEXT_PUBLIC_ARMZ_CLAIMS_ENABLED=false
NEXT_PUBLIC_ARMZ_MARKETPLACE_ENABLED=false
NEXT_PUBLIC_ARMZ_MAINNET_ENABLED=false

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_PROJECT_REF=

SUPABASE_REMOTE_WRITES_APPROVED=false
RUN_HOSTED_SUPABASE_TESTS=false

# -----------------------------------------------------------------------------
# REOWN + SOLANA DEVNET (Phase 2)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_ARMZ_TOKEN_MINT=
NEXT_PUBLIC_ARMZ_NFT_COLLECTION=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=

# -----------------------------------------------------------------------------
# AUTH SECRETS (Phase 2) — generate unique values; never reuse
# -----------------------------------------------------------------------------
ARMZ_WALLET_NONCE_SECRET=
ARMZ_SESSION_SIGNING_SECRET=
ARMZ_REQUEST_METADATA_SECRET=
ARMZ_REWARD_SIGNER_SECRET=
ARMZ_PRODUCTION_ADMIN_WRITES_APPROVED=false

ARMZ_NONCE_TTL_SECONDS=300
ARMZ_SESSION_TTL_SECONDS=1800
ARMZ_SESSION_ABSOLUTE_TTL_SECONDS=86400
ARMZ_SESSION_RENEWAL_WINDOW_SECONDS=600
ARMZ_SESSION_COOKIE_NAME=armz_clash_session
ARMZ_CSRF_COOKIE_NAME=armz_clash_csrf
ARMZ_COOKIE_DOMAIN=

ARMZ_WEB_ORIGIN=http://localhost:3000
ARMZ_GAME_ORIGIN=http://localhost:3001
ARMZ_ADMIN_ORIGIN=http://localhost:3002
ARMZ_API_ORIGIN=http://localhost:4000

ARMZ_AUTH_NONCE_IP_LIMIT=10
ARMZ_AUTH_NONCE_WALLET_LIMIT=5
ARMZ_AUTH_VERIFY_IP_LIMIT=15
ARMZ_AUTH_VERIFY_WALLET_LIMIT=8

# -----------------------------------------------------------------------------
# TREASURY PLACEHOLDERS (later phases)
# -----------------------------------------------------------------------------
ARMZ_TREASURY_PUBLIC_KEY=
ARMZ_REWARD_TREASURY_PUBLIC_KEY=
ARMZ_MARKETPLACE_FEE_TREASURY_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# SERVICE PORTS
# -----------------------------------------------------------------------------
ARMZ_API_PORT=4000
ARMZ_WORKER_HEALTH_PORT=4002
