{
  "name": "armz-clash",
  "version": "0.1.0",
  "private": true,
  "description": "Armz Clash — premium browser-based Solana arm-wrestling game (Phase 1 foundation)",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @armz-clash/web dev",
    "dev:game": "pnpm --filter @armz-clash/game dev",
    "dev:admin": "pnpm --filter @armz-clash/admin dev",
    "dev:api": "pnpm --filter @armz-clash/api dev",
    "dev:worker": "pnpm --filter @armz-clash/worker dev",
    "build": "turbo run build",
    "build:assets": "tsx scripts/build-game-assets.ts && tsx scripts/build-phase34-assets.ts",
    "build:assets:phase34": "tsx scripts/build-phase34-assets.ts",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:simulation": "tsx scripts/phase34-million-simulation.ts",
    "assets:validate": "vitest run scripts/phase34-asset-manifest.test.ts",
    "test:db": "tsx scripts/db-validate.ts",
    "test:db:hosted": "tsx scripts/hosted-db-validate.ts",
    "test:rls:hosted": "tsx scripts/hosted-rls-probes.ts",
    "test:rls:auth:hosted": "tsx scripts/hosted-auth-rls-probes.ts",
    "test:rls:demo:hosted": "tsx scripts/hosted-demo-rls-probes.ts",
    "test:demo:persistence:hosted": "tsx scripts/hosted-demo-persistence.ts",
    "test:auth:security": "vitest run --config vitest.integration.config.ts",
    "db:lint:hosted": "tsx scripts/hosted-db-lint.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules .turbo coverage playwright-report test-results",
    "clean:next": "tsx scripts/clean-next.ts",
    "doctor": "tsx scripts/doctor.ts",
    "dev:doctor": "tsx scripts/doctor.ts",
    "env:check": "tsx scripts/env-check.ts",
    "db:validate": "tsx scripts/db-validate.ts",
    "secrets:scan": "tsx scripts/secrets-scan.ts",
    "audit:client-bundles": "tsx scripts/client-bundle-secret-audit.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm env:check && pnpm secrets:scan && pnpm db:validate",
    "quality:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm env:check && pnpm secrets:scan && pnpm db:validate && pnpm audit:client-bundles"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@supabase/supabase-js": "^2.52.1",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.4",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "tsx": "^4.20.3",
    "turbo": "^2.5.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
