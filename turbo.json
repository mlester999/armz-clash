{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "ARMZ_ENVIRONMENT",
    "ARMZ_APP_VERSION",
    "ARMZ_LOG_LEVEL",
    "ARMZ_API_PORT",
    "ARMZ_WORKER_HEALTH_PORT",
    "ARMZ_WEB_ORIGIN",
    "ARMZ_GAME_ORIGIN",
    "ARMZ_ADMIN_ORIGIN",
    "ARMZ_API_ORIGIN",
    "ARMZ_DEMO_MODE_ENABLED",
    "ARMZ_REAL_MINT_ENABLED",
    "ARMZ_REAL_REWARDS_ENABLED",
    "ARMZ_CLAIMS_ENABLED",
    "ARMZ_MARKETPLACE_ENABLED",
    "ARMZ_MARKETPLACE_SETTLEMENT_ENABLED",
    "ARMZ_ORACLE_ENABLED",
    "ARMZ_MAINNET_ENABLED",
    "ARMZ_ADMIN_ECONOMY_WRITES_ENABLED",
    "ARMZ_DEMO_FORCE_MEMORY",
    "ARMZ_DEMO_SESSION_TTL_SECONDS",
    "ARMZ_DEMO_REPLAY_COOLDOWN_SECONDS",
    "ARMZ_DEMO_ARMZ_RESET_COOLDOWN_SECONDS",
    "ARMZ_DEMO_MAX_BATTLES_PER_SESSION",
    "ARMZ_DEMO_SESSION_COOKIE_NAME",
    "ARMZ_DEMO_CONFIGURATION_VERSION",
    "ARMZ_DEMO_SESSION_SIGNING_SECRET",
    "ARMZ_WALLET_NONCE_SECRET",
    "ARMZ_SESSION_SIGNING_SECRET",
    "ARMZ_REQUEST_METADATA_SECRET",
    "ARMZ_REWARD_SIGNER_SECRET",
    "ARMZ_PRODUCTION_ADMIN_WRITES_APPROVED",
    "ARMZ_NONCE_TTL_SECONDS",
    "ARMZ_SESSION_TTL_SECONDS",
    "ARMZ_SESSION_ABSOLUTE_TTL_SECONDS",
    "ARMZ_SESSION_RENEWAL_WINDOW_SECONDS",
    "ARMZ_SESSION_COOKIE_NAME",
    "ARMZ_CSRF_COOKIE_NAME",
    "ARMZ_COOKIE_DOMAIN",
    "ARMZ_AUTH_NONCE_IP_LIMIT",
    "ARMZ_AUTH_NONCE_WALLET_LIMIT",
    "ARMZ_AUTH_VERIFY_IP_LIMIT",
    "ARMZ_AUTH_VERIFY_WALLET_LIMIT",
    "ARMZ_FORCE_SECURE_COOKIES",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_DATABASE_URL",
    "SUPABASE_PROJECT_REF",
    "SUPABASE_REMOTE_WRITES_APPROVED",
    "RUN_HOSTED_SUPABASE_TESTS",
    "SOLANA_RPC_URL",
    "SOLANA_WS_URL",
    "SENTRY_DSN",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "CI",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_REOWN_PROJECT_ID",
        "NEXT_PUBLIC_ARMZ_NETWORK",
        "NEXT_PUBLIC_ARMZ_API_URL",
        "NEXT_PUBLIC_ARMZ_WEB_URL",
        "NEXT_PUBLIC_ARMZ_GAME_URL",
        "NEXT_PUBLIC_ARMZ_DEMO_MODE_ENABLED",
        "NEXT_PUBLIC_ARMZ_REAL_MINT_ENABLED",
        "NEXT_PUBLIC_ARMZ_REAL_REWARDS_ENABLED",
        "NEXT_PUBLIC_ARMZ_CLAIMS_ENABLED",
        "NEXT_PUBLIC_ARMZ_MARKETPLACE_ENABLED",
        "NEXT_PUBLIC_ARMZ_MAINNET_ENABLED",
        "NEXT_PUBLIC_ARMZ_PRODUCT_NAME",
        "NEXT_PUBLIC_ARMZ_TOKEN_NAME",
        "NEXT_PUBLIC_ARMZ_TOKEN_SYMBOL",
        "NEXT_PUBLIC_ARMZ_DOCS_VERSION",
        "NEXT_PUBLIC_ARMZ_ENVIRONMENT",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_ARMZ_TOKEN_MINT",
        "NEXT_PUBLIC_ARMZ_NFT_COLLECTION",
        "NEXT_PUBLIC_SENTRY_DSN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_REOWN_PROJECT_ID",
        "NEXT_PUBLIC_ARMZ_NETWORK",
        "NEXT_PUBLIC_ARMZ_API_URL",
        "NEXT_PUBLIC_ARMZ_WEB_URL",
        "NEXT_PUBLIC_ARMZ_GAME_URL",
        "NEXT_PUBLIC_ARMZ_DEMO_MODE_ENABLED",
        "NEXT_PUBLIC_ARMZ_REAL_MINT_ENABLED",
        "NEXT_PUBLIC_ARMZ_REAL_REWARDS_ENABLED",
        "NEXT_PUBLIC_ARMZ_CLAIMS_ENABLED",
        "NEXT_PUBLIC_ARMZ_MARKETPLACE_ENABLED",
        "NEXT_PUBLIC_ARMZ_MAINNET_ENABLED",
        "NEXT_PUBLIC_ARMZ_PRODUCT_NAME",
        "NEXT_PUBLIC_ARMZ_TOKEN_NAME",
        "NEXT_PUBLIC_ARMZ_TOKEN_SYMBOL",
        "NEXT_PUBLIC_ARMZ_DOCS_VERSION",
        "NEXT_PUBLIC_ARMZ_ENVIRONMENT",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_ARMZ_TOKEN_MINT",
        "NEXT_PUBLIC_ARMZ_NFT_COLLECTION",
        "NEXT_PUBLIC_SENTRY_DSN"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
